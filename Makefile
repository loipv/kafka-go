GO ?= go
export CGO_ENABLED = 1

.PHONY: build test test-short test-race test-integration vet lint cover cover-check tidy vuln
build:            ; $(GO) build ./...
test:             ; $(GO) test ./...
test-short:       ; $(GO) test -short ./...
test-race:        ; $(GO) test -race ./...
test-integration: ; $(GO) test -tags=integration -timeout=15m ./kafka/...
vet:              ; $(GO) vet ./... && $(GO) vet -tags=integration ./kafka/...
lint:             ; golangci-lint run
cover:            ; $(GO) test -race -coverprofile=coverage.out -covermode=atomic -coverpkg=./kafka/... ./... && $(GO) tool cover -func=coverage.out | tail -1
COVER_MIN ?= 80
cover-check:      ; $(GO) test -race -coverprofile=coverage.out -covermode=atomic ./kafka/... && $(GO) tool cover -func=coverage.out | awk -v min=$(COVER_MIN) '/^total:/ {sub("%","",$$3); if ($$3+0 < min) {printf "coverage %.1f%% is below %d%%\n", $$3, min; exit 1} printf "coverage %.1f%%\n", $$3}'
tidy:             ; $(GO) mod tidy
vuln:             ; $(GO) run golang.org/x/vuln/cmd/govulncheck@latest ./...
